{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhammer://schemas/faction",
  "type": "object",
  "required": ["schemaVersion", "version", "id", "name", "editionId", "armyRule"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "number" },
    "version": { "type": "string" },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "editionId": { "type": "string" },
    "armyRule": {
      "type": "object",
      "required": ["name", "effects"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "paraphrase": { "type": "string" },
        "effects": { "type": "array", "items": { "$ref": "openhammer://schemas/common#/$defs/effectDef" } }
      }
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "effects"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "effects": { "type": "array", "items": { "$ref": "openhammer://schemas/common#/$defs/effectDef" } }
        }
      }
    }
  }
}
